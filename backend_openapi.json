{
  "openapi": "3.1.0",
  "info": {
    "title": "Dealer App Backend API",
    "version": "0.1.0",
    "description": "OpenAPI specification for the Dealer App FastAPI backend. The schema covers the core MVP resources: users, companies, clients, products and deals."
  },
  "servers": [
    {
      "url": "{protocol}://{host}:{port}",
      "description": "Configurable FastAPI server",
      "variables": {
        "protocol": {
          "enum": ["https", "http"],
          "default": "https"
        },
        "host": {
          "default": "api.dealerapp.local"
        },
        "port": {
          "enum": ["443", "80", "8000"],
          "default": "443"
        }
      }
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Companies" },
    { "name": "Clients" },
    { "name": "Products" },
    { "name": "Deals" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Application health status",
        "operationId": "read_health",
        "responses": {
          "200": {
            "description": "Health information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "0.1.0" }
                  },
                  "required": ["status", "version"]
                }
              }
            }
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange credentials for an access token",
        "operationId": "create_token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Auth"],
        "summary": "Validate current session",
        "operationId": "read_session",
        "responses": {
          "200": {
            "description": "Current user session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" }
                  },
                  "required": ["user"]
                }
              }
            }
          },
          "401": {
            "description": "Session expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Retrieve authenticated profile",
        "operationId": "read_current_user",
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/companies": {
      "get": {
        "tags": ["Companies"],
        "summary": "List companies",
        "operationId": "list_companies",
        "responses": {
          "200": {
            "description": "A list of companies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Company" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/clients": {
      "get": {
        "tags": ["Clients"],
        "summary": "Paginated clients",
        "operationId": "list_clients",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 },
            "required": false,
            "description": "Page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 },
            "required": false,
            "description": "Items per page"
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "required": false,
            "description": "Search by name, phone or email"
          }
        ],
        "responses": {
          "200": {
            "description": "Clients response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientsCollection"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "post": {
        "tags": ["Clients"],
        "summary": "Create a client",
        "operationId": "create_client",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/clients/{client_id}": {
      "parameters": [
        {
          "name": "client_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Clients"],
        "summary": "Retrieve a client",
        "operationId": "read_client",
        "responses": {
          "200": {
            "description": "Client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          },
          "404": {
            "description": "Client not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "patch": {
        "tags": ["Clients"],
        "summary": "Update a client",
        "operationId": "update_client",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Client updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "delete": {
        "tags": ["Clients"],
        "summary": "Archive a client",
        "operationId": "delete_client",
        "responses": {
          "204": {
            "description": "Client archived"
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Paginated products",
        "operationId": "list_products",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/ProductStatus" },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Products response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsCollection"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "operationId": "create_product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/products/{product_id}": {
      "parameters": [
        {
          "name": "product_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Products"],
        "summary": "Retrieve a product",
        "operationId": "read_product",
        "responses": {
          "200": {
            "description": "Product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update a product",
        "operationId": "update_product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Archive a product",
        "operationId": "delete_product",
        "responses": {
          "204": {
            "description": "Product archived"
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/deals": {
      "get": {
        "tags": ["Deals"],
        "summary": "Paginated deals",
        "operationId": "list_deals",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/DealStatus" },
            "required": false
          },
          {
            "name": "advisor_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Deals response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealsCollection"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "post": {
        "tags": ["Deals"],
        "summary": "Create a deal",
        "operationId": "create_deal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Deal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deal"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/deals/{deal_id}": {
      "parameters": [
        {
          "name": "deal_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Deals"],
        "summary": "Retrieve a deal",
        "operationId": "read_deal",
        "responses": {
          "200": {
            "description": "Deal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deal"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "patch": {
        "tags": ["Deals"],
        "summary": "Update a deal",
        "operationId": "update_deal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deal updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deal"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/deals/{deal_id}/notes": {
      "parameters": [
        {
          "name": "deal_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["Deals"],
        "summary": "List notes for a deal",
        "operationId": "list_deal_notes",
        "responses": {
          "200": {
            "description": "Deal notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DealNote" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "post": {
        "tags": ["Deals"],
        "summary": "Create a note",
        "operationId": "create_deal_note",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealNoteCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DealNote"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthTokenRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        },
        "required": ["email", "password"]
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "token_type": { "type": "string", "example": "bearer" },
          "expires_in": { "type": "integer", "minimum": 0 },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["access_token", "token_type", "expires_in", "user"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "loc": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "msg": { "type": "string" },
                    "type": { "type": "string" }
                  },
                  "required": ["loc", "msg", "type"]
                }
              }
            ]
          }
        },
        "required": ["detail"]
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "address": { "type": "string", "nullable": true },
          "logo_url": { "type": "string", "format": "uri", "nullable": true }
        },
        "required": ["id", "name"]
      },
      "UserRole": {
        "type": "string",
        "enum": ["root", "admin", "advisor"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "full_name": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "is_active": { "type": "boolean", "default": true },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "company_id",
          "email",
          "role",
          "is_active",
          "created_at"
        ]
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company_id": { "type": "string", "format": "uuid" },
          "full_name": { "type": "string" },
          "email": { "type": "string", "format": "email", "nullable": true },
          "phone": { "type": "string" },
          "dni": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "company_id",
          "full_name",
          "phone",
          "created_at",
          "updated_at"
        ]
      },
      "ClientCreate": {
        "type": "object",
        "properties": {
          "full_name": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "minLength": 6 },
          "email": { "type": "string", "format": "email", "nullable": true },
          "dni": { "type": "string", "nullable": true }
        },
        "required": ["full_name", "phone"]
      },
      "ClientUpdate": {
        "type": "object",
        "properties": {
          "full_name": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "email": { "type": "string", "format": "email", "nullable": true },
          "dni": { "type": "string", "nullable": true }
        }
      },
      "ClientsCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Client" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["data", "meta"]
      },
      "ProductStatus": {
        "type": "string",
        "enum": ["available", "reserved", "sold", "archived"]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "price": { "type": "number" },
          "status": { "$ref": "#/components/schemas/ProductStatus" },
          "cover_photo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "company_id",
          "name",
          "price",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "nullable": true },
          "price": { "type": "number", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/ProductStatus" }
        },
        "required": ["name", "price", "status"]
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "price": { "type": "number", "nullable": true },
          "status": { "$ref": "#/components/schemas/ProductStatus" }
        }
      },
      "ProductsCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Product" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["data", "meta"]
      },
      "DealStatus": {
        "type": "string",
        "enum": ["pending", "assigned", "completed", "lost", "in_collection"]
      },
      "Deal": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "company_id": { "type": "string", "format": "uuid" },
          "advisor_id": { "type": "string", "format": "uuid" },
          "client_id": { "type": "string", "format": "uuid" },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/DealStatus" },
          "notes": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "company_id",
          "advisor_id",
          "client_id",
          "scheduled_at",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "DealCreate": {
        "type": "object",
        "properties": {
          "advisor_id": { "type": "string", "format": "uuid" },
          "client_id": { "type": "string", "format": "uuid" },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/DealStatus" },
          "notes": { "type": "string", "nullable": true }
        },
        "required": ["advisor_id", "client_id", "scheduled_at", "status"]
      },
      "DealUpdate": {
        "type": "object",
        "properties": {
          "advisor_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "client_id": { "type": "string", "format": "uuid", "nullable": true },
          "product_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": { "$ref": "#/components/schemas/DealStatus" },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "DealNote": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "deal_id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "body": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "deal_id", "user_id", "body", "created_at"]
      },
      "DealNoteCreate": {
        "type": "object",
        "properties": {
          "body": { "type": "string", "minLength": 1 }
        },
        "required": ["body"]
      },
      "DealsCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Deal" }
          },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        },
        "required": ["data", "meta"]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "page_size": { "type": "integer", "minimum": 1 },
          "total_items": { "type": "integer", "minimum": 0 },
          "total_pages": { "type": "integer", "minimum": 0 }
        },
        "required": ["page", "page_size", "total_items", "total_pages"]
      }
    }
  }
}
